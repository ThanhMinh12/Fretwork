FRETWORK_DATA_DIR=./data
FRETWORK_MAX_UPLOAD_MB=200
FRETWORK_MAX_AUDIO_SECONDS=180
FRETWORK_MAX_PENDING_JOBS=4
FRETWORK_MAX_STORAGE_MB=2048
# Set true behind HTTPS. The persistent /data/.session-secret is generated once
# if FRETWORK_SESSION_SECRET is not provided (minimum 32 characters).
FRETWORK_COOKIE_SECURE=false
